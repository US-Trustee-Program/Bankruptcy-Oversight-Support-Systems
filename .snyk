# Snyk policy file — SCA license finding ignores
# https://docs.snyk.io/snyk-cli/commands/policy
version: v1.25.0
ignore:
  'snyk:lic:npm:rasha:MPL-2.0':
    - '*':
        reason: >-
          Transitive dependency of @okta/okta-sdk-nodejs. MPL-2.0 is weak
          copyleft compatible with project use. Package is unmodified.
  'snyk:lic:npm:eckles:MPL-2.0':
    - '*':
        reason: >-
          Transitive dependency of @okta/okta-sdk-nodejs. MPL-2.0 is weak
          copyleft compatible with project use. Package is unmodified.
  SNYK-JS-JSONBIGINT-6148131:
    - '*':
        reason: 'False positive - json-bigint not in package-lock.json or dependency tree'
        expires: 2026-05-06T00:00:00.000Z
  SNYK-JS-XML2JS-5414874:
    - '*':
        reason: 'False positive - xml2js not in package-lock.json or dependency tree'
        expires: 2026-05-06T00:00:00.000Z
  SNYK-JS-UUID-16133035:
    - '*':
        reason: >-
          Transitive dependency via launchdarkly-js-sdk-common, @azure/msal-node,
          and njwt. No fixed version available from upstream packages.
        expires: 2026-05-23T00:00:00.000Z
  SNYK-JS-JSYAML-18313070:
    - '*':
        reason: >-
          Transitive dependency via @okta/okta-sdk-nodejs@8.1.0 and
          cosmiconfig@8.3.6 (via vite-plugin-svgr), both pinned to js-yaml
          ^4.1.0. Fix requires js-yaml 5.2.2, a major version bump with
          breaking API/schema changes (see js-yaml migrate_v4_to_v5 guide)
          that needs compatibility validation before adoption. 5.2.2 was
          also published 2026-07-23, inside CAMS's 14/30-day minimum
          release age window. js-yaml only parses local, non-attacker-
          controlled config files here (okta config-loader.js, cosmiconfig
          build tooling), so exploitability is low in the interim.
        expires: 2026-08-24T00:00:00.000Z
  SNYK-JS-NODEFORGE-19635204:
    - '*':
        reason: >-
          Transitive dependency via @okta/okta-sdk-nodejs@8.1.0, which
          hard-depends on node-jose for its own package.json (every
          node-jose version, 0.9.0 through latest, requires node-forge,
          so no version swap avoids this). CVE-2026-85393 is an RSA
          signature-verification bypass, but our only reachable node-jose
          call is JWS.createSign for outbound DPoP proof signing
          (@okta/okta-sdk-nodejs/src/dpop.js) — JWS.createVerify is never
          invoked anywhere in our usage. Re-verified 2026-09-30: still no
          fixed node-forge version on npm (latest remains 1.4.0). Upstream
          fix PR #1151 was closed in favor of #1152
          (digitalbazaar/forge#1152), which remains open/unmerged against
          digitalbazaar/forge#1149. Shortened renewal window to 2 weeks
          given active upstream PR churn.
        expires: 2026-10-14T00:00:00.000Z
  SNYK-JS-DOMPURIFY-20361471:
    - '*':
        reason: >-
          Cross-site Scripting (XSS) in dompurify, affecting versions
          3.4.13-3.4.15 (current pin: 3.4.13, forced via root package.json
          overrides). Fix is 3.4.16, published 2026-09-23, but it's inside
          CAMS's 14-day minimum release age window (.npmrc
          min-release-age=14) until 2026-10-07. Will bump the root
          overrides entry and user-interface/package.json to 3.4.16 once
          it clears the window.
        expires: 2026-10-08T00:00:00.000Z
  SNYK-JS-REACTROUTER-18313151:
    - '*':
        reason: >-
          Transitive dependency via user-interface's react-router-dom,
          now at 7.18.4 (hoisted into test/e2e and test/uswds), which
          still pins react-router below the 8.3.0 fix — react-router-dom
          has never published an 8.x release; v8 unifies routing into
          the react-router package directly. Migration off
          react-router-dom to react-router v8 is tracked by CAMS-854 and
          in progress (only a small fraction of imports converted so
          far). Re-verified 2026-09-30: this ignore lapsed 2026-09-10
          without renewal; renewing now. The CVE is an RSC/server-actions
          CSRF bypass; CAMS is a client-only SPA that uses neither RSC
          nor server actions, so exploitability remains low in the
          interim.
        expires: 2026-10-14T00:00:00.000Z
