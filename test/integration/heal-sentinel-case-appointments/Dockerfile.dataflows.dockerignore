# Build-context ignore file for Dockerfile.dataflows (passed with --ignorefile by
# scripts/start-services.sh). It replaces the repo-root .dockerignore for this build.
#
# The dataflows host runs dotenv.config(), so any .env file copied into the image would supply
# every variable local.settings.integration.json does not set, including real lower-environment
# connection strings. No .env or local.settings.json from the working tree may enter the image.
**/.env
**/.env.*
**/local.settings.json
**/node_modules/
**/.git/
data/
user-interface/test-results/
user-interface/playwright-report/
user-interface/coverage/
test/e2e/test-results/
test/e2e/playwright-report/
test/e2e/mongodb-data/
test/e2e/sqlserver-data/
test/e2e/fixtures/
