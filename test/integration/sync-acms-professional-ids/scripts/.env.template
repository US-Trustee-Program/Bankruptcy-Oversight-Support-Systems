# SQL Edge SA password used by start-services.sh AND the harness script
# (test/integration/sync-acms-professional-ids/scripts/sync-acms-professional-ids-harness.ts
# reads this file directly for local runs).
#
# IMPORTANT: this value must exactly match the ACMS_MSSQL_PASS/MSSQL_PASS
# values baked into ../local.settings.integration.json — that file is baked
# into the dataflows Docker image at build time, so the containerized
# function app authenticates to SQL Edge with whatever password is in
# local.settings.integration.json, not this file. If you change the
# password here, update local.settings.integration.json to match and rebuild
# the image (start-services.sh rebuilds it automatically).
#
# Copy this file: cp .env.template .env
#
# .env is gitignored — never commit it.

# Required: set a strong password (min 8 chars, upper+lower+digit+symbol) —
# default matches local.settings.integration.json's baked-in value.
MSSQL_PASS=YourStrong!Passw0rd
