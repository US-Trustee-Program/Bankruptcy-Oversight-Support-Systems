# Local-only. Copy to .env.local (gitignored) and set the two passwords to the SQL Edge SA password in scripts/.env.
# The harness refuses to run unless every target below is local and COSMOS_DATABASE_NAME contains '-idxtest-'.
MONGO_CONNECTION_STRING=mongodb://localhost:27017
COSMOS_DATABASE_NAME=sync-trustee-case-appointments-idxtest-local

ACMS_MSSQL_HOST=localhost
ACMS_MSSQL_DATABASE=ACMS_INT
ACMS_MSSQL_USER=sa
ACMS_MSSQL_PASS=<set me>
ACMS_MSSQL_ENCRYPT=false
ACMS_MSSQL_TRUST_UNSIGNED_CERT=true

MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE_DXTR=DXTR_INT
MSSQL_USER=sa
MSSQL_PASS=<set me>
MSSQL_ENCRYPT=true
MSSQL_TRUST_UNSIGNED_CERT=true

CAMS_LOGIN_PROVIDER=mock
DATABASE_MOCK=false
