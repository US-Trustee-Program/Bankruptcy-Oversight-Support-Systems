# Copy to .env.local (gitignored) and fill in. These override backend/.env so the harness talks
# to the local containers started by scripts/start-services.sh, never a real environment.

# Cosmos stand-in
MONGO_CONNECTION_STRING=mongodb://localhost:27017/cams-ust-division-backfills?retrywrites=false
COSMOS_DATABASE_NAME=cams-ust-division-backfills

# DXTR stand-in. MSSQL_PASS must match scripts/.env.
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE_DXTR=DXTR_INT
MSSQL_USER=sa
MSSQL_PASS=
MSSQL_ENCRYPT=false
MSSQL_TRUST_UNSIGNED_CERT=true

# The backfills construct an application context through the production factory, which expects
# these to be present even though this harness exercises no feature flags or auth.
FEATURE_FLAG_SDK_KEY=
CAMS_LOGIN_PROVIDER=mock
