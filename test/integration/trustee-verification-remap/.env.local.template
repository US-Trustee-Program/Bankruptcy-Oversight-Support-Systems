# Copy to .env.local (gitignored). Points the harness at the containers started by
# scripts/start-services.sh. The function app reads its own settings from
# local.settings.integration.json; these are for the harness process itself.

MONGO_CONNECTION_STRING=mongodb://localhost:27017/cams-trustee-verification-remap-local?retrywrites=false
COSMOS_DATABASE_NAME=cams-trustee-verification-remap-local

# Azurite's well-known development shorthand — the harness enqueues the remap message and reads
# the DLQ through this.
AzureWebJobsStorage=UseDevelopmentStorage=true
AzureWebJobsDataflowsStorage=UseDevelopmentStorage=true
