# Local environment for the trustee-verification-remap harness script.
# Copy this file: cp .env.local.template .env.local
# (from test/integration/trustee-verification-remap/)
#
# Values below match what start-services.sh starts: MongoDB and Azurite as
# localhost-published Podman pod siblings. No secrets required — Azurite's
# well-known development storage account and a bare MongoDB with no auth.
#
# .env.local is gitignored — never commit it.

MONGO_CONNECTION_STRING=mongodb://localhost:27017
COSMOS_DATABASE_NAME=cams-trustee-verification-remap-local
AzureWebJobsStorage=UseDevelopmentStorage=true
AzureWebJobsDataflowsStorage=UseDevelopmentStorage=true
