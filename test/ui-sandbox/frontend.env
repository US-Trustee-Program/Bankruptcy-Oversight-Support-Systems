# Source this before `npm run start --workspace=user-interface` to point the frontend dev
# server at the ui-sandbox backend + fake-okta server. `source test/ui-sandbox/frontend.env` —
# exported vars win over user-interface/.env because dotenv.config() does not overwrite
# already-set process.env values.

export CAMS_LOGIN_PROVIDER=okta
export CAMS_LOGIN_PROVIDER_CONFIG='issuer=https://localhost:8443/oauth2/default|clientId=sandbox-client'
export CAMS_SERVER_HOSTNAME=localhost
export CAMS_SERVER_PORT=7071
export CAMS_SERVER_PROTOCOL=http
export CAMS_BASE_PATH=/api
export CAMS_FEATURE_FLAGS_MODE=test
